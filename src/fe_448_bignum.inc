// fe448_mul + fe448_invert via rsa_bignum — correct big-integer modulo
inline void fe448_mul(fe448 h, const fe448 f, const fe448 g) {
    uint8_t fb[56], gb[56];
    fe448_tobytes(fb, f); fe448_tobytes(gb, g);
    uint8_t fbe[56], gbe[56];
    for(int i=0;i<56;++i){ fbe[i]=fb[55-i]; gbe[i]=gb[55-i]; }
    rsa_bignum rf=rsa_bignum::from_bytes(fbe,56), rg=rsa_bignum::from_bytes(gbe,56);
    rsa_bignum rp; bn_mul(rp, rf, rg);
    static const uint8_t pb[56]={
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfe,0xff,0xff,0xff,
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff};
    uint8_t pbe[56]; for(int i=0;i<56;++i) pbe[i]=pb[55-i];
    static const rsa_bignum pp=rsa_bignum::from_bytes(pbe,56);
    rsa_bignum rm; bn_mod(rm, rp, pp);
    uint8_t be[256], le[56]; rm.to_bytes(be);
    for(int i=0;i<56;++i) le[i]=be[255-i];
    fe448_frombytes(h, le);
}

inline void fe448_sq(fe448 h, const fe448 f) {
    fe448 t; fe448_copy(t, f);
    fe448_mul(h, t, t);
}

inline void fe448_invert(fe448 out, const fe448 z) {
    uint8_t zb[56]; fe448_tobytes(zb, z);
    uint8_t zbe[56]; for(int i=0;i<56;++i) zbe[i]=zb[55-i];
    rsa_bignum rz=rsa_bignum::from_bytes(zbe,56);
    static const uint8_t pb[56]={
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfe,0xff,0xff,0xff,
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,
        0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff};
    uint8_t pbe[56]; for(int i=0;i<56;++i) pbe[i]=pb[55-i];
    static const rsa_bignum pp=rsa_bignum::from_bytes(pbe,56);
    rsa_bignum ri; bn_modinv(ri, rz, pp);
    uint8_t be[256], le[56]; ri.to_bytes(be);
    for(int i=0;i<56;++i) le[i]=be[255-i];
    fe448_frombytes(out, le);
}
